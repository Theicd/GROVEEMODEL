{
  "name": "groveemodel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-reality-ui.mjs && vite",
    "build": "node scripts/sync-reality-ui.mjs && tsc -b && vite build",
    "build:pages-docs": "node scripts/build-pages-docs.mjs",
    "sync:reality": "node scripts/sync-reality-ui.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run --exclude app/src/webSearch/webSearch.live.test.ts --exclude app/src/gameSearch/gameSearch.live.test.ts",
    "test:search": "vitest run app/src/webSearch/webSearch.live.test.ts",
    "test:games": "vitest run app/src/gameSearch/gameSearch.live.test.ts",
    "qa:pages": "node --import tsx scripts/qa-pages.mjs",
    "qa:capabilities": "node --import tsx scripts/probe-capability-suite.ts",
    "qa:live-replies": "node --import tsx scripts/probe-live-replies.ts",
    "qa:browser-model": "node --import tsx scripts/probe-browser-model.ts",
    "qa:presentation": "node --import tsx scripts/probe-presentation-browser.ts",
    "qa:vision": "node scripts/qa-vision-premium.mjs",
    "check-node": "node scripts/check-node.mjs",
    "postinstall": "node scripts/download-face-models.mjs",
    "models:face": "node scripts/download-face-models.mjs"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@mediapipe/tasks-vision": "0.10.14",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow-models/pose-detection": "^2.1.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "face-api.js": "^0.22.2",
    "heic2any": "^0.0.4",
    "mammoth": "^1.12.0",
    "onnxruntime-web": "^1.20.0",
    "pdfjs-dist": "^6.0.227",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tesseract.js": "^6.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "playwright": "^1.59.1",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
