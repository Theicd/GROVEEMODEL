# Copy to .env and restart: npm run dev
#
# SearXNG — web search for topical questions (gaming, robotics, AI trends, …)
# Option A: local Docker (recommended for dev)
#   docker run -d --name searxng -p 8888:8080 searxng/searxng
#   VITE_SEARXNG_URL=http://127.0.0.1:8888
#
# Option B: dev proxy path (set SEARXNG_UPSTREAM in shell or .env — server-side only)
#   VITE_SEARXNG_URL=/api/searxng
#   SEARXNG_UPSTREAM=http://127.0.0.1:8888
#
VITE_SEARXNG_URL=

# Optional CORS relay for GitHub Pages (RSS / news). Cloudflare Worker URL ending with ?url=
# VITE_CORS_PROXY_URL=https://your-worker.workers.dev/?url=
VITE_CORS_PROXY_URL=

# Optional TMDB enrichment (posters + ratings) — requires API key
# VITE_TMDB_API_KEY=

# Israeli supermarket products — catalog from kitchen-inventory + Open Food Facts
# Price queries («כמה עולה חלב») use Cheapersal API (30+ chains, live prices)
# Free tier: 100 requests/day — https://cheapersal.co.il/developers
# Dev proxy (recommended — key stays server-side):
#   CHEAPERSAL_API_KEY=your_key_here
# Production static build (key in browser — less secure):
#   VITE_CHEAPERSAL_API_KEY=your_key_here
CHEAPERSAL_API_KEY=

# Pixabay — stock images & video (PIXEL-ISR / pixel-isr.com logic)
# Uses same API as PIXEL-ISR; optional override:
# VITE_PIXABAY_API_KEY=
# VITE_PIXABAY_PER_PAGE=12

# Hugging Face — optional token for Inference API probe from the browser
# VITE_HF_TOKEN=hf_...

# Federated video search (browser-only, no API keys)
# PeerTube global index (default: Sepia Search)
# VITE_SEPIA_SEARCH_URL=https://sepiasearch.org
# Invidious instances for YouTube mirror search (comma-separated)
# VITE_INVIDIOUS_INSTANCES=https://invidious.privacyredirect.com,https://inv.nadeko.net
# VITE_PIPED_INSTANCES=https://pipedapi.adminforge.de,https://api.piped.projectsegfau.lt
